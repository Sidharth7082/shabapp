# Leave both blank to run the app in local demo mode (no backend, OTP shown on screen).
# Fill them in to switch the job/OTP layer to Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OTP provider used by the verify-otp edge function (server-side only).
# MSG91_AUTH_KEY / WHATSAPP_TOKEN are configured as Supabase secrets, not here.
VITE_OTP_CHANNEL=sms
